{
  "name": "customs-night",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @customs/db run migrate",
    "db:types": "pnpm --filter @customs/db run types",
    "db:start": "pnpm --filter @customs/db run start",
    "db:stop": "pnpm --filter @customs/db run stop",
    "db:reset": "pnpm --filter @customs/db run reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
