# Node 25 is newer than some tools' declared engine ranges. Warn, do not fail.
engine-strict=false
# Next.js and Biome ship optional platform binaries; hoist nothing else.
strict-peer-dependencies=false

# One workspace at a time for every recursive command (M3.28).
#
# `pnpm -r test` used to run `packages/db` and `apps/web` at once, and both drive the *same*
# Supabase CLI local stack, where the active season is a singleton: the web admin suite's
# "start a season" case moved it out from under the db suite's "a game defaults to the active
# season", and one run in six failed cases that pass alone. Nothing namespaces a singleton, so
# the packages take turns instead. The whole suite is under a minute either way.
#
# It lives here and not only in the root `test` script because `pnpm -r test` is what CLAUDE.md
# tells everyone to type, and that spelling never reads a script of ours.
workspace-concurrency=1
